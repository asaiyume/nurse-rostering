{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nurse rostering roster v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "candidate",
        "unknown",
        "infeasible_claim"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nurse_id": {
            "type": "string",
            "minLength": 1
          },
          "day": {
            "enum": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ]
          },
          "shift": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "nurse_id",
          "day",
          "shift",
          "skill"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "explanation",
    "roster"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "infeasible_claim"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "roster": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
